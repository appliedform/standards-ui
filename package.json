{
  "name": "@standards/packs-ui",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "freshness": "node scripts/freshness.mjs",
    "build": "node scripts/build.mjs",
    "audit": "node scripts/audit.mjs",
    "workflow:render": "node scripts/workflow-render.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run generate:check && npm run freshness && npm run build && npm run audit && npm test"
  },
  "devDependencies": {
    "@fontsource/dm-mono": "5.3.0",
    "@fontsource/public-sans": "5.3.0",
    "@types/react": "^19.2.18",
    "esbuild": "^0.28.2",
    "playwright": "1.63.0",
    "react": "^19.2.8",
    "react-dom": "19.2.8",
    "typescript": "^5.6.0"
  }
}
