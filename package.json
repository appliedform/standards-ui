{
  "name": "@standards/packs-ui",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "freshness": "node scripts/freshness.mjs",
    "build": "node scripts/build.mjs",
    "audit": "node scripts/audit.mjs",
    "check": "npm run generate:check && npm run freshness && npm run build && npm run audit && npm run test",
    "test": "node test/render.mjs"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.6.0"
  }
}
